            <option value="agency">Digital / SEO Agency (White-Label)</option>
            <option value="local-id">UMKM / Bisnis Lokal (Indonesia)</option>
          </select>
        </div>
        <div class="f-group">
          <label for="f-topic">Target Topic or Keyword</label>
