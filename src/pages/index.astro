---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Hero from '../components/Hero.astro';
import IcpGrid from '../components/IcpGrid.astro';
import PricingGrid from '../components/PricingGrid.astro';
import CaseStudyGrid from '../components/CaseStudyGrid.astro';
import LeadForm from '../components/LeadForm.astro';
import GeoFaqAccordion from '../components/GeoFaqAccordion.astro';
import Footer from '../components/Footer.astro';
---
<BaseLayout>
  <div class="page">
    <div class="panel" aria-hidden="true">
      <i class="bar l b1"></i><i class="bar l b2"></i><i class="bar l b3"></i><i class="bar l b4"></i><i class="bar l b5"></i>
      <i class="bar r b1"></i><i class="bar r b2"></i><i class="bar r b3"></i><i class="bar r b4"></i><i class="bar r b5"></i>
    </div>
    <Navbar />
    <Hero />
    <main class="main-wrap">
      <IcpGrid />
      <!-- MODULE 2: COMPARISON MATRIX -->
      <section class="sec" aria-label="Agency Comparison">
        <div class="sec-head">
          <span class="sec-tag">Why JetDigitalPro</span>
          <h2>Engineered for the AI Search Era</h2>
        </div>
        <div class="comp-box">
          <table class="comp-table">
            <thead>
              <tr>
                <th>Capability &amp; Quality Standard</th>
                <th class="hl">JetDigitalPro (Dual-Engine)</th>
                <th>Cheap AI Content Mills</th>
                <th>Traditional SEO Agencies</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Google SEO + AI Search (GEO) Optimization</td>
                <td class="hl"><span class="badge-yes">✓ Built-In Dual Optimization</span></td>
                <td><span class="badge-no">✕ Raw unedited LLM output</span></td>
                <td><span class="badge-no">△ Legacy keyword density only</span></td>
              </tr>
              <tr>
                <td>Editorial &amp; Fact-Checking Process</td>
                <td class="hl"><span class="badge-yes">✓ 100% Senior Human Editors</span></td>
                <td><span class="badge-no">✕ Zero human verification</span></td>
                <td><span class="badge-yes">✓ Human writers (slow)</span></td>
              </tr>
              <tr>
                <td>Entity &amp; Schema Markup Readiness</td>
                <td class="hl"><span class="badge-yes">✓ JSON-LD &amp; Answer-Led H2s</span></td>
                <td><span class="badge-no">✕ Plain text walls</span></td>
                <td><span class="badge-no">△ Extra technical fee</span></td>
              </tr>
              <tr>
                <td>Delivery Turnaround &amp; Risk-Free Trial</td>
                <td class="hl"><span class="badge-yes">✓ 5–7 Days + Free Sample</span></td>
                <td><span class="badge-yes">✓ Instant (High penalty risk)</span></td>
                <td><span class="badge-no">✕ 3–6 Weeks + High retainer</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
      <PricingGrid />
      <!-- PAGE 3: WHITE-LABEL BANNER -->
      <section class="sec" id="white-label">
        <div class="wl-banner">
          <div>
            <span class="sec-tag">For SEO &amp; Digital Agencies</span>
            <h2>Scale Your Agency Fulfillment Without Hiring In-House</h2>
            <p class="sec-sub">Deliver cutting-edge GEO &amp; SEO content under your own brand. We operate invisibly behind strict NDAs with predictable margins and zero editorial headaches.</p>
            <div style="margin-top:24px; display:flex; gap:12px; flex-wrap:wrap;">
              <a class="btn btn-lime" href="#free-sample">Request White-Label Sample</a>
              <a class="btn btn-ghost" href="#case-studies">See Agency Results</a>
            </div>
          </div>
          <div class="wl-specs">
            <div class="wl-stat"><b>100% NDA</b><span>Strict client confidentiality &amp; unbranded docs</span></div>
            <div class="wl-stat"><b>5–7 Days</b><span>Guaranteed SLA turnaround for client sprints</span></div>
            <div class="wl-stat"><b>GEO Ready</b><span>AI citation reports you can present to clients</span></div>
            <div class="wl-stat"><b>2 Regions</b><span>Global English &amp; local Indonesian fulfillment</span></div>
          </div>
        </div>
      </section>
      <CaseStudyGrid />
      <GeoFaqAccordion />
      <LeadForm />
    </main>
    <Footer />
  </div>
</BaseLayout>
